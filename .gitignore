/prompts
/runs

# personal-only preference data (advisory_personal etc.) never gets committed
/preference/personal_*

# the personal task file is built from real private chat history, never ships
/tasks/personal.yaml

# local corpus pulls and caches
*.jsonl
wildchat_*_summary.txt
.cache/
.openrouter_catalogue_cache.json

__pycache__/
*.pyc
.pytest_cache/

# secrets
.env
*api_key*

# chat-driven blind-vote state (A/B mapping, must stay hidden until the vote)
.vote_state/

# rendered blind vote pairs (contain personal task text; local only)
.vote_view/

# live catalogue snapshot (regenerate, do not trust a committed copy)
catalogue.json

# bibliographic lookup cache (regenerable, and large)
.citation_cache.json

# generated grading pages embed full transcripts, which are themselves
# gitignored, and each is tied to a bundle mapping in .vote_state/
grade_*.html
!grade_template.html
votes_*.json

# replay approval and picks downloads, in case one is saved into the repo;
# everything else replay.py writes is under /prompts already
approved_*.json
picks_*.json
